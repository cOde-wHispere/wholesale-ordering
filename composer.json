{
    "name": "code-whispere/wholesale-ordering",
    "description": "Wholesale ordering extension for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "1.1",
        "wp-phpunit/wp-phpunit": "7.1.0"
    },
    "autoload": {
        "psr-4": {
            "WholesaleOrdering\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WholesaleOrdering\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
